Gráficos de tonner Bar Gauge:
Title: "${printer_card:text}"
Options -> Legend: "{{supply}}"
-------------------------------

label_replace(
  (
    (
      100 * prtMarkerSuppliesLevel{job="printers_snmp", device_name="$printer_card"}
      /
      prtMarkerSuppliesMaxCapacity{job="printers_snmp", device_name="$printer_card"}
    )
    and on(instance, hrDeviceIndex, prtMarkerSuppliesIndex, prtMarkerSuppliesType)
      prtMarkerSuppliesMaxCapacity{job="printers_snmp", device_name="$printer_card"} > 0
    and on(instance, hrDeviceIndex, prtMarkerSuppliesIndex, prtMarkerSuppliesType)
      prtMarkerSuppliesLevel{job="printers_snmp", device_name="$printer_card"} >= 0
  )
  * on(instance, hrDeviceIndex, prtMarkerSuppliesIndex, prtMarkerSuppliesType)
    group_left(prtMarkerSuppliesDescription)
      prtMarkerSuppliesDescription{
        job="printers_snmp",
        device_name="$printer_card",
        prtMarkerSuppliesDescription=~"(?i).*(black toner|cyan toner|magenta toner|yellow toner|toner cartridge|print cartridge|black cartridge|cartucho de toner).*"
      },
  "supply",
  "$1",
  "prtMarkerSuppliesDescription",
  "^([^,;]+).*"
)

